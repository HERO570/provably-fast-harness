+#[test]
+fn cached_and_owned_targets_preserve_rows_and_suffixes() {
+    use super::*;
+    use itertools::Itertools;
+
+    // Queries plus omitted-leaf positions can be out of order and can repeat a row.
+    let positions = [9usize, 2, 2, 8, 3, 15];
+    let stripe_log_size = 2;
+    let stripes = positions
+        .iter()
+        .map(|position| position >> stripe_log_size)
+        .sorted()
+        .dedup()
+        .collect_vec();
+    let rows_of = |log_size: u32, stripe: usize| {
+        let shift = stripe_log_size - log_size;
+        positions
+            .iter()
+            .filter(|&&position| position >> stripe_log_size == stripe)
+            .map(|&position| {
+                let local = position - (stripe << stripe_log_size);
+                (local >> (shift + 1) << 1) + (local & 1)
+            })
+            .sorted()
+            .dedup()
+            .collect_vec()
+    };
+    let cache: DecommitTargetCache = [0, 1, 2]
+        .into_iter()
+        .map(|log_size| {
+            (log_size, stripes.iter().map(|&stripe| (stripe, rows_of(log_size, stripe))).collect())
+        })
+        .collect();
+
+    for log_size in 0..=2 {
+        let expected: DecommitTargetList =
+            stripes.iter().map(|&stripe| (stripe, rows_of(log_size, stripe))).collect();
+        assert_eq!(
+            decommit_targets(&Some(cache.clone()), &stripes, log_size, None, &rows_of).as_ref(),
+            expected
+        );
+        assert_eq!(decommit_targets(&None, &stripes, log_size, None, &rows_of).as_ref(), expected);
+        for first_stripe in [0, 1, 2, 3, 4] {
+            let suffix: DecommitTargetList = expected
+                .iter()
+                .filter(|(stripe, _)| *stripe >= first_stripe)
+                .cloned()
+                .collect();
+            assert_eq!(
+                decommit_targets(
+                    &Some(cache.clone()),
+                    &stripes,
+                    log_size,
+                    Some(first_stripe),
+                    &rows_of
+                )
+                .as_ref(),
+                suffix
+            );
+            assert_eq!(
+                decommit_targets(&None, &stripes, log_size, Some(first_stripe), &rows_of).as_ref(),
+                suffix
+            );
+        }
+    }
+}
+
+#[test]
+fn target_cache_budget_checks_empty_overflow_and_actual_capacities() {
+    use super::*;
+
+    assert_eq!(decommit_target_cache_estimate(1, 0, 1), None);
+    assert_eq!(decommit_target_cache_estimate(1, 1, 0), None);
+    assert_eq!(decommit_target_cache_estimate(usize::MAX, usize::MAX, usize::MAX), None);
+    assert!(!decommit_target_cache_estimate_within_budget(None));
+    assert!(decommit_target_cache_estimate_within_budget(Some(DECOMMIT_TARGET_CACHE_BUDGET)));
+    assert!(!decommit_target_cache_estimate_within_budget(Some(DECOMMIT_TARGET_CACHE_BUDGET + 1)));
+
+    let small = decommit_target_cache_estimate(1, 1, 1).unwrap();
+    assert!(small <= DECOMMIT_TARGET_CACHE_BUDGET);
+    let over_budget = decommit_target_cache_estimate(1, 1024, 1024).unwrap();
+    assert!(over_budget > DECOMMIT_TARGET_CACHE_BUDGET);
+
+    let rows_of = |log_size: u32, stripe: usize| vec![log_size as usize + stripe];
+    let mut used_sizes = [false; usize::BITS as usize];
+    used_sizes[0] = true;
+    let stripes = [0usize, 1];
+    let small_cache = build_decommit_target_cache(&used_sizes, 2, &stripes, rows_of).unwrap();
+    assert!(decommit_target_cache_within_budget(&small_cache));
+    assert_eq!(small_cache, vec![(0, vec![(0, vec![0]), (1, vec![1])])]);
+    assert!(build_decommit_target_cache(&used_sizes, 0, &stripes, rows_of).is_none());
+    assert!(build_decommit_target_cache(&used_sizes, usize::MAX, &stripes, rows_of).is_none());
+    assert!(build_decommit_target_cache(&used_sizes, 1024, &vec![0; 1024], rows_of).is_none());
+
+    let empty: DecommitTargetCache = Vec::new();
+    assert!(decommit_target_cache_within_budget(&empty));
+    let oversized: DecommitTargetCache = vec![(0, vec![(0, vec![0; DECOMMIT_TARGET_CACHE_BUDGET])])];
+    assert!(!decommit_target_cache_within_budget(&oversized));
+}
+
+#[test]
+fn over_budget_cache_falls_back_to_the_canonical_owned_builder() {
+    use super::*;
+
+    let stripes: Vec<usize> = (0..1024).collect();
+    let used_sizes = [true; usize::BITS as usize];
+    let rows_of = |log_size: u32, stripe: usize| vec![log_size as usize + stripe];
+    let cache = build_decommit_target_cache(&used_sizes, 1024, &stripes, &rows_of);
+    assert!(cache.is_none());
+
+    let fallback = decommit_targets(&cache, &stripes, 3, Some(1018), &rows_of);
+    let expected: DecommitTargetList = stripes
+        .iter()
+        .copied()
+        .filter(|&stripe| stripe >= 1018)
+        .map(|stripe| (stripe, rows_of(3, stripe)))
+        .collect();
+    assert_eq!(fallback.as_ref(), expected);
+}
