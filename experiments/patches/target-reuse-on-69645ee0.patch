+const DECOMMIT_TARGET_CACHE_BUDGET: usize = 64 * 1024;
+type DecommitTargetList = Vec<(usize, Vec<usize>)>;
+type DecommitTargetCache = Vec<(u32, DecommitTargetList)>;
+const DECOMMIT_TARGET_CACHE_STACK_BYTES: usize =
+    std::mem::size_of::<[bool; usize::BITS as usize]>()
+        + std::mem::size_of::<DecommitTargetCache>()
+        + std::mem::size_of::<Option<DecommitTargetCache>>();
+
+fn mark_decommit_target_size(
+    used_sizes: &mut [bool; usize::BITS as usize],
+    log_size: u32,
+) -> bool {
+    let Ok(index) = usize::try_from(log_size) else {
+        return false;
+    };
+    let Some(used) = used_sizes.get_mut(index) else {
+        return false;
+    };
+    *used = true;
+    true
+}
+
+fn decommit_target_cache_estimate(
+    n_sizes: usize,
+    n_positions: usize,
+    n_stripes: usize,
+) -> Option<usize> {
+    if n_sizes == 0 || n_positions == 0 || n_stripes == 0 {
+        return None;
+    }
+    let row_slots = n_sizes
+        .checked_mul(n_stripes)?
+        .checked_mul(n_positions)?
+        .checked_mul(std::mem::size_of::<usize>())?;
+    let target_slots = n_sizes
+        .checked_mul(n_stripes)?
+        .checked_mul(std::mem::size_of::<(usize, Vec<usize>)>())?;
+    let size_entries = n_sizes.checked_mul(std::mem::size_of::<(u32, DecommitTargetList)>())?;
+    row_slots
+        .checked_add(target_slots)?
+        .checked_add(size_entries)?
+        .checked_add(DECOMMIT_TARGET_CACHE_STACK_BYTES)
+}
+
+fn decommit_target_cache_capacity_bytes(cache: &DecommitTargetCache) -> Option<usize> {
+    let mut bytes = cache
+        .capacity()
+        .checked_mul(std::mem::size_of::<(u32, DecommitTargetList)>())?;
+    for (_, targets) in cache {
+        bytes = bytes.checked_add(
+            targets.capacity().checked_mul(std::mem::size_of::<(usize, Vec<usize>)>())?,
+        )?;
+        for (_, rows) in targets {
+            bytes = bytes.checked_add(rows.capacity().checked_mul(std::mem::size_of::<usize>())?)?;
+        }
+    }
+    Some(bytes)
+}
+
+fn decommit_target_cache_within_budget(cache: &DecommitTargetCache) -> bool {
+    decommit_target_cache_capacity_bytes(cache)
+        .and_then(|bytes| bytes.checked_add(DECOMMIT_TARGET_CACHE_STACK_BYTES))
+        .is_some_and(|bytes| bytes <= DECOMMIT_TARGET_CACHE_BUDGET)
+}
+
+fn decommit_target_cache_estimate_within_budget(estimate: Option<usize>) -> bool {
+    estimate.is_some_and(|bytes| bytes <= DECOMMIT_TARGET_CACHE_BUDGET)
+}
+
+fn build_decommit_target_cache(
+    used_sizes: &[bool; usize::BITS as usize],
+    n_positions: usize,
+    stripes: &[usize],
+    rows_of: impl Fn(u32, usize) -> Vec<usize>,
+) -> Option<DecommitTargetCache> {
+    let n_sizes = used_sizes.iter().filter(|&&used| used).count();
+    if !decommit_target_cache_estimate_within_budget(decommit_target_cache_estimate(
+        n_sizes,
+        n_positions,
+        stripes.len(),
+    )) {
+        return None;
+    }
+
+    let mut cache = Vec::new();
+    cache.try_reserve_exact(n_sizes).ok()?;
+    for (log_size, &used) in used_sizes.iter().enumerate() {
+        if !used {
+            continue;
+        }
+        let Ok(log_size) = u32::try_from(log_size) else {
+            return None;
+        };
+        let targets = stripes
+            .iter()
+            .map(|&stripe| (stripe, rows_of(log_size, stripe)))
+            .collect_vec();
+        cache.push((log_size, targets));
+        if !decommit_target_cache_within_budget(&cache) {
+            return None;
+        }
+    }
+    decommit_target_cache_within_budget(&cache).then_some(cache)
+}
+
+fn decommit_targets<'a>(
+    cache: &'a Option<DecommitTargetCache>,
+    stripes: &[usize],
+    log_size: u32,
+    first_stripe: Option<usize>,
+    rows_of: impl Fn(u32, usize) -> Vec<usize>,
+) -> Cow<'a, [(usize, Vec<usize>)]> {
+    if let Some((_, targets)) = cache
+        .as_ref()
+        .and_then(|cache| cache.binary_search_by_key(&log_size, |(size, _)| *size).ok().map(|i| &cache[i]))
+    {
+        let start = first_stripe.map_or(0, |first| {
+            targets.partition_point(|(stripe, _)| *stripe < first)
+        });
+        return Cow::Borrowed(&targets[start..]);
+    }
+    Cow::Owned(
+        stripes
+            .iter()
+            .copied()
+            .filter(|&stripe| first_stripe.map_or(true, |first| stripe >= first))
+            .map(|stripe| (stripe, rows_of(log_size, stripe)))
+            .collect(),
+    )
+}
 
