index 0000000000000000000000000000000000000000..a0f062e5b94acfff7bf1f6f0fa89693735c06a8d
--- /dev/null
+++ b/crates/prover/src/witness/components/paired_lookup_delta/tests.rs
@@ -0,0 +1,231 @@
+use cairo_air::relations::CommonLookupElements;
+use stwo::core::channel::Blake2sChannel;
+use stwo::core::fields::m31::{M31, P};
+use stwo::core::fields::qm31::QM31;
+use stwo::prover::backend::simd::m31::{LOG_N_LANES, N_LANES, PackedM31};
+use stwo::prover::backend::simd::qm31::PackedQM31;
+
+use crate::witness::components::paired_lookup_delta::{
+    add_delta, denominator_delta, paired_denominators, paired_fraction,
+    paired_fraction_from_denominators,
+};
+use crate::witness::prelude::{LogupTraceGenerator, Relation};
+
+fn packed(values: [M31; N_LANES]) -> PackedM31 {
+    PackedM31::from_array(values)
+}
+
+fn original_fraction(
+    denominator0: PackedQM31,
+    denominator1: PackedQM31,
+    multiplicity0: PackedM31,
+    multiplicity1: PackedM31,
+) -> (PackedQM31, PackedQM31) {
+    (-(denominator0 * multiplicity1 + denominator1 * multiplicity0), denominator0 * denominator1)
+}
+
+fn trace_bytes(
+    common: &CommonLookupElements,
+    relation_id0: PackedM31,
+    relation_id1: PackedM31,
+    sequence: PackedM31,
+    multiplicity0: PackedM31,
+    multiplicity1: PackedM31,
+    optimized: bool,
+) -> (Vec<u8>, QM31) {
+    let delta = denominator_delta(common, relation_id0, relation_id1);
+    let log_size = LOG_N_LANES;
+    let mut logup = unsafe { LogupTraceGenerator::uninitialized(log_size) };
+    logup.write_frac_cols(1, |_, _| {
+        if optimized {
+            paired_fraction(common, relation_id0, sequence, delta, multiplicity0, multiplicity1)
+        } else {
+            let denominator0: PackedQM31 = common.combine(&[relation_id0, sequence]);
+            let denominator1: PackedQM31 = common.combine(&[relation_id1, sequence]);
+            original_fraction(denominator0, denominator1, multiplicity0, multiplicity1)
+        }
+    });
+    let (trace, claimed_sum) = logup.finalize_last();
+    let bytes = trace
+        .iter()
+        .flat_map(|evaluation| {
+            evaluation.values.as_slice().iter().flat_map(|value| value.0.to_ne_bytes())
+        })
+        .collect();
+    (bytes, claimed_sum)
+}
+
+#[test]
+fn production_pair_matches_original_for_drawn_challenges_and_real_ids() {
+    let relation_pairs = [
+        (1410849886, 514232941),
+        (531010560, 480677703),
+        (497455322, 447122465),
+        (463900084, 682009131),
+        (1109051422, 1424798916),
+        (P - 2, 3), // Exercise modular relation-ID subtraction.
+    ];
+    let mut channel = Blake2sChannel::default();
+
+    for challenge_index in 0..12u32 {
+        let common = CommonLookupElements::draw(&mut channel);
+        for (left, right) in relation_pairs {
+            let relation_id0 = PackedM31::broadcast(M31::from(left));
+            let relation_id1 = PackedM31::broadcast(M31::from(right));
+            let sequence = packed(std::array::from_fn(|lane| {
+                M31::from((challenge_index * 101 + lane as u32 * 7919 + 1) % P)
+            }));
+            let multiplicity0 = packed(std::array::from_fn(|lane| {
+                if lane % 4 == 0 {
+                    M31::from_u32_unchecked(P)
+                } else {
+                    M31::from((challenge_index * 17 + lane as u32 * 13 + 2) % P)
+                }
+            }));
+            let multiplicity1 = packed(std::array::from_fn(|lane| {
+                if lane % 4 == 1 {
+                    M31::from_u32_unchecked(P)
+                } else {
+                    M31::from((challenge_index * 23 + lane as u32 * 29 + 3) % P)
+                }
+            }));
+
+            let delta = denominator_delta(&common, relation_id0, relation_id1);
+            let (actual0, actual1) = paired_denominators(&common, relation_id0, sequence, delta);
+            let expected0: PackedQM31 = common.combine(&[relation_id0, sequence]);
+            let expected1: PackedQM31 = common.combine(&[relation_id1, sequence]);
+            assert_eq!(actual0.to_array(), expected0.to_array());
+            assert_eq!(actual1.to_array(), expected1.to_array());
+
+            let actual = paired_fraction(
+                &common,
+                relation_id0,
+                sequence,
+                delta,
+                multiplicity0,
+                multiplicity1,
+            );
+            let expected = paired_fraction_from_denominators(
+                expected0,
+                expected1,
+                multiplicity0,
+                multiplicity1,
+            );
+            let original = original_fraction(expected0, expected1, multiplicity0, multiplicity1);
+            assert_eq!(actual.0.to_array(), original.0.to_array());
+            assert_eq!(actual.1.to_array(), original.1.to_array());
+            assert_eq!(expected.0.to_array(), original.0.to_array());
+            assert_eq!(expected.1.to_array(), original.1.to_array());
+        }
+    }
+}
+
+#[test]
+fn production_denominator_addition_preserves_zero_cases_and_raw_m31_zero() {
+    let zero = PackedQM31::broadcast(QM31::from_u32_unchecked(0, 0, 0, 0));
+    let one = PackedQM31::broadcast(QM31::from_u32_unchecked(1, 0, 0, 0));
+    let minus_one = -one;
+    let cases = [(zero, one), (one, minus_one), (zero, zero)];
+    let raw_zero_and_p = packed(std::array::from_fn(|lane| {
+        if lane % 2 == 0 { M31::from_u32_unchecked(0) } else { M31::from_u32_unchecked(P) }
+    }));
+    let multiplicity_other = PackedM31::broadcast(M31::from(7));
+
+    for (denominator0, delta) in cases {
+        let (actual0, actual1) =
+            crate::witness::components::paired_lookup_delta::add_delta(denominator0, delta);
+        let expected1 = denominator0 + delta;
+        assert_eq!(actual0.to_array(), denominator0.to_array());
+        assert_eq!(actual1.to_array(), expected1.to_array());
+
+        let actual =
+            paired_fraction_from_denominators(actual0, actual1, raw_zero_and_p, multiplicity_other);
+        let expected =
+            original_fraction(denominator0, expected1, raw_zero_and_p, multiplicity_other);
+        assert_eq!(actual.0.to_array(), expected.0.to_array());
+        assert_eq!(actual.1.to_array(), expected.1.to_array());
+    }
+}
+
+#[test]
+fn production_logup_trace_bytes_match_original_pair_formula() {
+    let mut channel = Blake2sChannel::default();
+    for challenge_index in 0..4u32 {
+        let common = CommonLookupElements::draw(&mut channel);
+        let relation_id0 = PackedM31::broadcast(M31::from(1410849886));
+        let relation_id1 = PackedM31::broadcast(M31::from(514232941));
+        let sequence = packed(std::array::from_fn(|lane| {
+            M31::from((challenge_index * 997 + lane as u32 * 211 + 1) % P)
+        }));
+        let multiplicity0 = PackedM31::broadcast(M31::from(5 + challenge_index));
+        let multiplicity1 = PackedM31::broadcast(M31::from(11 + challenge_index));
+        let optimized = trace_bytes(
+            &common,
+            relation_id0,
+            relation_id1,
+            sequence,
+            multiplicity0,
+            multiplicity1,
+            true,
+        );
+        let original = trace_bytes(
+            &common,
+            relation_id0,
+            relation_id1,
+            sequence,
+            multiplicity0,
+            multiplicity1,
+            false,
+        );
+        assert_eq!(optimized, original);
+    }
+}
+
+#[test]
+fn zero_denominator_lanes_preserve_original_logup_trace_bytes() {
+    let zero = QM31::from_u32_unchecked(0, 0, 0, 0);
+    let one = QM31::from_u32_unchecked(1, 0, 0, 0);
+    let denominator0 = PackedQM31::from_array(std::array::from_fn(|lane| match lane % 3 {
+        0 => zero,
+        1 => one,
+        _ => zero,
+    }));
+    let denominator1 = PackedQM31::from_array(std::array::from_fn(|lane| match lane % 3 {
+        0 => one,
+        1 => zero,
+        _ => zero,
+    }));
+    let delta = denominator1 - denominator0;
+    let multiplicity0 = packed(std::array::from_fn(|lane| {
+        if lane % 2 == 0 { M31::from_u32_unchecked(0) } else { M31::from_u32_unchecked(P) }
+    }));
+    let multiplicity1 = PackedM31::broadcast(M31::from(7));
+
+    let log_size = LOG_N_LANES;
+    let mut optimized = unsafe { LogupTraceGenerator::uninitialized(log_size) };
+    optimized.write_frac_cols(1, |_, _| {
+        let (d0, d1) = add_delta(denominator0, delta);
+        paired_fraction_from_denominators(d0, d1, multiplicity0, multiplicity1)
+    });
+    let (optimized_trace, optimized_sum) = optimized.finalize_last();
+    let optimized_bytes: Vec<u8> = optimized_trace
+        .iter()
+        .flat_map(|evaluation| {
+            evaluation.values.as_slice().iter().flat_map(|value| value.0.to_ne_bytes())
+        })
+        .collect();
+
+    let mut original = unsafe { LogupTraceGenerator::uninitialized(log_size) };
+    original.write_frac_cols(1, |_, _| {
+        original_fraction(denominator0, denominator1, multiplicity0, multiplicity1)
+    });
+    let (original_trace, original_sum) = original.finalize_last();
+    let original_bytes: Vec<u8> = original_trace
+        .iter()
+        .flat_map(|evaluation| {
+            evaluation.values.as_slice().iter().flat_map(|value| value.0.to_ne_bytes())
+        })
+        .collect();
+    assert_eq!(optimized_bytes, original_bytes);
+    assert_eq!(optimized_sum, original_sum);
+}
