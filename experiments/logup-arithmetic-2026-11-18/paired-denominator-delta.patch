index 0000000000000000000000000000000000000000..56272246db28a330a454806a02d5e7d5e560b6cf
--- /dev/null
+++ b/crates/prover/src/witness/components/paired_lookup_delta.rs
@@ -0,0 +1,64 @@
+use crate::witness::prelude::*;
+
+/// Computes the change in the common lookup denominator between two relation IDs.
+///
+/// This uses the relation's actual `combine` implementation rather than assuming that its first
+/// coefficient is one. The common lookup challenge is shared by all rows and this result is
+/// computed once per pair by the caller.
+#[inline(always)]
+pub(crate) fn denominator_delta(
+    common_lookup_elements: &relations::CommonLookupElements,
+    relation_id0: PackedM31,
+    relation_id1: PackedM31,
+) -> PackedQM31 {
+    let zero = PackedM31::zero();
+    let right: PackedQM31 = common_lookup_elements.combine(&[relation_id1, zero]);
+    let left: PackedQM31 = common_lookup_elements.combine(&[relation_id0, zero]);
+    right - left
+}
+
+/// Adds a precomputed pair delta to the first exact denominator.
+#[inline(always)]
+pub(crate) fn add_delta(denominator0: PackedQM31, delta: PackedQM31) -> (PackedQM31, PackedQM31) {
+    (denominator0, denominator0 + delta)
+}
+
+/// Returns both denominators, reusing the first tuple's row-dependent combination.
+#[inline(always)]
+pub(crate) fn paired_denominators(
+    common_lookup_elements: &relations::CommonLookupElements,
+    relation_id0: PackedM31,
+    sequence: PackedM31,
+    delta: PackedQM31,
+) -> (PackedQM31, PackedQM31) {
+    let denominator0: PackedQM31 = common_lookup_elements.combine(&[relation_id0, sequence]);
+    add_delta(denominator0, delta)
+}
+
+/// Computes the unchanged paired LogUp fraction from its exact two denominators.
+#[inline(always)]
+pub(crate) fn paired_fraction_from_denominators(
+    denominator0: PackedQM31,
+    denominator1: PackedQM31,
+    multiplicity0: PackedM31,
+    multiplicity1: PackedM31,
+) -> (PackedQM31, PackedQM31) {
+    (-(denominator0 * multiplicity1 + denominator1 * multiplicity0), denominator0 * denominator1)
+}
+
+/// Production row calculation shared by both paired fixed-table paths.
+#[inline(always)]
+pub(crate) fn paired_fraction(
+    common_lookup_elements: &relations::CommonLookupElements,
+    relation_id0: PackedM31,
+    sequence: PackedM31,
+    delta: PackedQM31,
+    multiplicity0: PackedM31,
+    multiplicity1: PackedM31,
+) -> (PackedQM31, PackedQM31) {
+    let (denominator0, denominator1) =
+        paired_denominators(common_lookup_elements, relation_id0, sequence, delta);
+    paired_fraction_from_denominators(denominator0, denominator1, multiplicity0, multiplicity1)
+}
+
+mod tests;
